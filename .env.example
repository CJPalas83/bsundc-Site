# Email backend (Resend) — required for the contact form.
# Get an API key at https://resend.com and add a verified sending domain.
# Copy this file to `.env.local` and fill in the values; .env.local is gitignored.

# Resend API key (server-only, never expose to the client)
RESEND_API_KEY=

# Sender address shown in outgoing emails. Until a custom domain is verified
# on Resend, use the sandbox sender below.
RESEND_FROM="BS&C <onboarding@resend.dev>"

# Inbox that receives form submissions
CONTACT_TO=info@bsundc.com
